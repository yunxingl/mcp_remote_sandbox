# --- Database (Postgres) ---
# Vercel: use Neon/Supabase/Vercel Postgres connection string
DATABASE_URL="postgresql://labbench:labbench@localhost:5432/labbench"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated list of emails allowed to sign in. Everyone else is rejected.
ALLOWED_EMAILS="lucy7298@gmail.com"
# Set to true when self-hosting behind a proxy (not needed on Vercel)
# AUTH_TRUST_HOST=true

# --- Claude chat integration (in-site tutor chat) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# --- MCP endpoint (shared tool for Claude Code) ---
# Static bearer token for /api/mcp. Generate with: openssl rand -hex 32
MCP_TOKEN=""

# --- Sandbox runner ---
# "local"  = run submissions as subprocesses on this machine (dev only)
# "modal"  = run submissions in Modal Sandboxes (arbitrary machine types / GPUs)
# "auto"   = use modal if MODAL_TOKEN_ID is set, else local
RUNNER_BACKEND="auto"
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
# Where the local runner keeps scratch dirs
LOCAL_RUNNER_DIR=".runs"
