generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth / Auth.js) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  workspaces    Workspace[]
  runs          Run[]
  chatMessages  ChatMessage[]
  problems      Problem[]
  createdAt     DateTime  @default(now())
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Platform ----------

// Problems authored dynamically (e.g. assigned by Claude via MCP).
// File-based content under content/ never touches this table.
model Problem {
  id          String   @id @default(cuid())
  courseSlug  String   // e.g. "assigned"
  slug        String
  title       String
  statementMd String   // multi-part markdown problem statement (sidebar)
  starter     Json     // { "path": "contents", ... }
  tests       Json     // { "path": "contents", ... } — must include run_tests.py
  machine     Json     // MachineSpec: { backend, image, gpu, cpu, memoryMb, pip, timeoutSec }
  difficulty  String   @default("medium")
  tags        String[] @default([])
  assignedTo  String?  // user id the task was assigned to (null = everyone)
  user        User?    @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  createdVia  String   @default("mcp") // "mcp" | "ui"
  createdAt   DateTime @default(now())

  @@unique([courseSlug, slug])
}

// Per-user saved editor state for a problem (multi-file).
model Workspace {
  id         String   @id @default(cuid())
  userId     String
  problemKey String   // "<courseSlug>/<problemSlug>"
  files      Json     // { "path": "contents", ... }
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, problemKey])
}

model Run {
  id         String    @id @default(cuid())
  userId     String
  problemKey String
  status     String    @default("queued") // queued | running | passed | failed | error | timeout
  backend    String    // local | modal
  machine    Json
  files      Json      // snapshot of submitted files
  logs       String    @default("")
  results    Json?     // parsed test results: { total, passed, cases: [{name, passed, message}] }
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, problemKey, createdAt])
}

// Per-user, per-problem tutor chat. MCP hints from Claude Code land here too.
model ChatMessage {
  id         String   @id @default(cuid())
  userId     String
  problemKey String
  role       String   // "user" | "assistant" | "mcp"
  content    String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, problemKey, createdAt])
}
